#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
PYTHON="${BLACKOUT_KB_VENV:-${PROJECT_ROOT}/.venv}/bin/python"

if [[ ! -x "${PYTHON}" ]]; then
  echo "Not installed. Run: bash ${PROJECT_ROOT}/linux/install.sh" >&2
  exit 2
fi

exec "${PYTHON}" -m blackout_ops_kb "$@"
