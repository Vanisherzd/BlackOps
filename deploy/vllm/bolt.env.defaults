# Bolt vLLM service defaults. Pre-set any variable in the environment to override it.
BOLT_IMAGE_TAG="${BOLT_IMAGE_TAG:-nightly-77154ca6116ae34cbfe314beef1016bde9b63989}"
BOLT_IMAGE="${BOLT_IMAGE:-blackbox-vllm-bolt:77154ca}"
BOLT_CONTAINER="${BOLT_CONTAINER:-vllm-bolt}"
MODEL_ID="${MODEL_ID:-nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB}"
MODEL_REVISION="${MODEL_REVISION:-}"
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-bolt}"
BOLT_HOST="${BOLT_HOST:-0.0.0.0}"
BOLT_PORT="${BOLT_PORT:-8200}"
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-1}"
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.45}"
HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
VLLM_CACHE_DIR="${VLLM_CACHE_DIR:-$HOME/.cache/vllm-bolt}"
BOLT_LOG_DIR="${BOLT_LOG_DIR:-./logs}"
BOLT_EXTRA_ARGS="${BOLT_EXTRA_ARGS:-}"
