.venv/
logs/
__pycache__/
*.pyc
.env
victim/conf.d/default.conf

# kb/ (knowledge pack) and datasets/: the raw benchmark clones (39 GB, kept on the Spark disk and the TRANSCEND USB)
# and regenerable build outputs stay out of git; kb/artifacts and kb/src/blackout_ops_kb/data are the tracked outputs
datasets/raw/
kb/build/
kb/dist/
kb/src/*.egg-info/
kb/integrations/nemoclaw/blackout-ops-rag/vendor/
kb/integrations/nemoclaw/blackout-ops-rag/data/
victim/known-good/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# NeMo sidecar venv (scripts/guard_api.py, scripts/nat_profile.py), built with uv pip, not part of uv.lock
.nemo-venv/

# DGX dataset provenance is curated explicitly; runtime receipts and backups stay local.
/kb/artifacts/*-backup-*/
/kb/artifacts/*-backup-*.npz
/datasets/derived/**/replay-*/
/datasets/derived/**/replay_worker_*.py
/datasets/derived/**/replay-stop-request.json
/datasets/derived/**/procedures-worker.out
/datasets/derived/**/runtime-preparation.json
/datasets/derived/**/installation-*.json
/datasets/derived/**/completion-report.json
/datasets/derived/**/live-rag-*
/datasets/derived/**/offline-validation.json
/datasets/derived/**/manifest.pre-install.json
/datasets/derived/**/install.py

# Model weights and local caches are transferred separately from Git.
/.cache/
/.hf-cache/
*.safetensors
*.gguf
*.ckpt
*.pt
*.pth
# community Q&A layer: the full question/answer text (19 MB) stays on the Spark; manifest, held-out split and index are tracked
/datasets/derived/stackexchange_ops_qa_20261022/qa.jsonl
# community v2: the per-site dump rows (160 MB) and the uncompressed index stay on the Spark; git carries community_v2.jsonl.gz
/datasets/derived/stackexchange_ops_qa_20261022/dump-*.jsonl
/kb/artifacts/community_v2.jsonl
# community FTS5 index: rebuilt from the shards with kb-community.py build-fts
/kb/artifacts/community.sqlite
