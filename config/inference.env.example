# OpenAI-compatible base URL used by the inference gateway clients. The integrated stack serves Bolt with
# scripts/serve-vllm.sh on :8000 as edge-agent (what the shim, agent.py and reviewer.py use); the standalone
# baseline (make bolt-up) is :8200 / bolt.
BLACKBOX_INFERENCE_BASE_URL=http://127.0.0.1:8000
# Stable model alias exposed by the vLLM service.
BLACKBOX_INFERENCE_MODEL=edge-agent
# Client request timeout in seconds for long reasoning responses.
BLACKBOX_INFERENCE_TIMEOUT_S=300

# Pinned upstream vLLM image tag used by the derived image build.
BOLT_IMAGE_TAG=nightly-77154ca6116ae34cbfe314beef1016bde9b63989
# Local derived image name and short immutable tag.
BOLT_IMAGE=blackbox-vllm-bolt:77154ca
# Docker container name owned by the Bolt lifecycle scripts.
BOLT_CONTAINER=vllm-bolt
# Hugging Face model repository served by vLLM.
MODEL_ID=nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB
# Optional model revision; empty selects the repository default branch.
MODEL_REVISION=
# Stable model name returned by the OpenAI-compatible API.
SERVED_MODEL_NAME=bolt
# Address bound by vLLM inside the host-networked container.
BOLT_HOST=0.0.0.0
# TCP port exposed by the host-networked vLLM service.
BOLT_PORT=8200
# Maximum model context length in tokens.
MAX_MODEL_LEN=32768
# Maximum number of concurrent sequences in the baseline.
MAX_NUM_SEQS=1
# Fraction of GPU memory vLLM may reserve.
GPU_MEMORY_UTILIZATION=0.45
# Host Hugging Face cache mounted at /root/.cache/huggingface.
HF_HOME=${HF_HOME:-$HOME/.cache/huggingface}
# Host vLLM cache mounted at /root/.cache/vllm.
VLLM_CACHE_DIR=${VLLM_CACHE_DIR:-$HOME/.cache/vllm-bolt}
# Host directory for launch metadata and service logs.
BOLT_LOG_DIR=${BOLT_LOG_DIR:-./logs}
# Optional whitespace-delimited vLLM arguments appended to the baseline argv.
BOLT_EXTRA_ARGS=
